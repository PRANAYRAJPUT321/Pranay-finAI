# ---------------------------------------------------------------------------
# PD FinPrep environment template. Copy to `.env` and fill in values.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://finprep:finprep@localhost:5432/finprep"

# Public base URL of the app, used to build links in emails (required in production)
APP_URL="http://localhost:3000"

# --- AI tutor (optional) ----------------------------------------------------
# AI_PROVIDER: "anthropic" | "openai" | "offline". When unset, the provider is
# chosen automatically from whichever API key is present, otherwise "offline"
# (grounded course-material retrieval, no generative model).
AI_PROVIDER=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
# Max tutor messages per user per hour
AI_TUTOR_HOURLY_LIMIT="30"

# --- Email (optional) -------------------------------------------------------
# EMAIL_PROVIDER: "console" (logs links to server output; development only) | "resend"
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="PD FinPrep <no-reply@example.com>"

# --- Billing (optional, not integrated yet) --------------------------------
# When "true", Free/Plus/Premium entitlements are enforced. Leave "false" during
# development so the full learning workflow is available.
ENFORCE_ENTITLEMENTS="false"

# --- Seed -------------------------------------------------------------------
# Credentials for the seeded administrator account (development only).
SEED_ADMIN_EMAIL="admin@finprep.local"
SEED_ADMIN_PASSWORD="ChangeMe!Admin123"
